# ──────────────────────────────────────────────────────────────────────────────
# Modul Woods — Environment Variables
# Copy this file to .env and fill in your real values.
# .env is git-ignored; .env.example is committed.
# ──────────────────────────────────────────────────────────────────────────────

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Who receives the contact-form submissions
CONTACT_TO=sales1@modul-woods.com

# Sender identity — must be a domain verified in Resend.
# For local testing you can use: "Modul Woods <onboarding@resend.dev>"
CONTACT_FROM=Modul Woods <no-reply@modul-woods.com>
