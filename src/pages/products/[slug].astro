---
import type { GetStaticPaths } from "astro";
import ProductDetailView from "@/components/views/ProductDetailView.astro";
import { getProducts } from "@/lib/products";
import type { Product } from "@/lib/products";

export const getStaticPaths: GetStaticPaths = async () => {
  const products = await getProducts("en");
  return products.map((product) => ({
    params: { slug: product.data.slug },
    props: { product, siblings: products },
  }));
};

interface Props {
  product: Product;
  siblings: Product[];
}

const { product, siblings } = Astro.props;
---

<ProductDetailView product={product} siblings={siblings} />
