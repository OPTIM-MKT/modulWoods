---
import Layout from "@/layouts/Layout.astro";
import PageHero from "@/components/shared/PageHero.astro";
import FinishTabs from "@/components/finishes/FinishTabs.astro";
import CtaSection from "@/components/shared/CtaSection.astro";

import { getI18N, getLang } from "@/i18n/i18n";
import { usePath } from "@/i18n/utils";

const lang = getLang(Astro.currentLocale);
const i18n = getI18N(lang);
const path = usePath(lang);

const copy = i18n.finishes;
const seo = i18n.seo.pages.finishes;
---

<Layout title={seo.title} description={seo.description}>
  <PageHero
    eyebrow={copy.eyebrow}
    title={copy.title}
    subtitle={copy.subtitle}
    description={copy.description}
  />

  <FinishTabs />

  <CtaSection
    eyebrow={copy.cta.eyebrow}
    title={copy.cta.title}
    description={copy.cta.description}
    primaryLabel={copy.cta.primary}
    primaryHref={path("contact")}
    secondaryLabel={copy.cta.secondary}
    secondaryHref={path("products")}
  />
</Layout>
